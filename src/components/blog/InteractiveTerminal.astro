---
interface Props {
  defaultHostname?: string;
}

const { defaultHostname = "localhost" } = Astro.props;
---

<div class="my-6 border border-edge font-mono text-xs overflow-hidden">
  <div class="flex items-center gap-2 px-4 py-2 bg-surface border-b border-edge">
    <span class="text-ghost">{defaultHostname}</span>
    <span class="text-edge">—</span>
    <span class="text-ghost">bash</span>
  </div>
  <div class="px-4 py-3 text-subtle">
    <span class="text-ghost">$</span> _
  </div>
</div>
