---
interface Props {
  title?: string;
  target?: string;
  type?: string;
  status?: string;
  fs?: string;
  network?: string;
  pid?: string;
}

const { title, target, type, status, fs, network, pid } = Astro.props;
---

<div class="my-6 border border-edge font-mono text-xs overflow-hidden">
  <div class="flex items-center justify-between px-4 py-2 bg-surface border-b border-edge">
    <span class="text-subtle">{title ?? "terminal"}</span>
    {type && <span class="text-ghost uppercase tracking-widest">{type}</span>}
  </div>

  {(target || status || fs || network || pid) && (
    <div class="flex flex-wrap gap-4 px-4 py-2 border-b border-edge text-ghost">
      {target  && <span>target: <span class="text-subtle">{target}</span></span>}
      {status  && <span>status: <span class="text-subtle">{status}</span></span>}
      {fs      && <span>fs: <span class="text-subtle">{fs}</span></span>}
      {network && <span>network: <span class="text-subtle">{network}</span></span>}
      {pid     && <span>pid: <span class="text-subtle">{pid}</span></span>}
    </div>
  )}

  <div class="px-4 py-3 text-dim leading-relaxed">
    <slot />
  </div>
</div>
