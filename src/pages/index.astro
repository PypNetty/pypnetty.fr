---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => {
  if (import.meta.env.DEV) return true;
  return !data.draft && new Date(data.date) <= new Date();
});

const recentPosts = allPosts
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .slice(0, 4);

const stack = ["Rust", "Go", "Linux", "Kubernetes", "GitOps", "Docker"];

const typeLabel: Record<string, string> = {
  kezako: "kezako",
  "deep-dive": "deep-dive",
  saga: "saga",
  series: "série",
};
---

<Layout
  title="PypNetty — Platform Engineer"
  description="Je construis des systèmes bas niveau parce que l'abstraction a un prix que je refuse de payer."
>
  <section class="relative border-b border-edge overflow-hidden">
    <div class="dot-grid absolute inset-0 opacity-40 pointer-events-none"></div>
    <div
      class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-base to-transparent pointer-events-none"
    >
    </div>

    <div class="relative max-w-3xl mx-auto px-6 pt-28 pb-24">
      <h1
        class="text-5xl sm:text-6xl font-semibold tracking-tight leading-none mb-5"
      >
        PypNetty
      </h1>

      <p class="font-mono text-sm text-quiet mb-8 tracking-wide">
        Platform Engineer &nbsp;·&nbsp; Rust &nbsp;·&nbsp; Go &nbsp;·&nbsp;
        Systems
      </p>

      <p class="text-fg2 text-lg leading-relaxed max-w-lg mb-10">
        Je construis des orchestrateurs, des noyaux et des outils qui descendent
        là où les abstractions s'arrêtent, et je documente chaque étape.
      </p>

      <div class="flex items-center gap-5">
        <a
          href="/blog"
          class="font-mono text-sm bg-fg text-base px-5 py-2.5 hover:opacity-80 transition-opacity"
        >
          lire le blog →
        </a>
        <a
          href="/projects"
          class="font-mono text-sm text-subtle hover:text-fg transition-colors"
        >
          projets →
        </a>
        <a
          href="/about"
          class="font-mono text-sm text-subtle hover:text-fg transition-colors"
        >
          à propos
        </a>
      </div>
    </div>
  </section>

  <section class="border-b border-edge">
    <div
      class="max-w-3xl mx-auto px-6 py-8 flex flex-wrap items-center gap-x-6 gap-y-3"
    >
      <span
        class="font-mono text-[10px] text-ghost tracking-widest uppercase shrink-0"
        >Stack</span
      >
      {
        stack.map((item) => (
          <span class="font-mono text-xs text-subtle">{item}</span>
        ))
      }
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-20">
    <div class="flex items-center justify-between mb-8">
      <p class="font-mono text-[10px] text-ghost tracking-widest uppercase">
        Articles récents
      </p>
      <a
        href="/blog"
        class="font-mono text-[11px] text-subtle hover:text-fg transition-colors"
      >
        tous →
      </a>
    </div>

    {
      recentPosts.length > 0 ? (
        <ul class="divide-y divide-edge">
          {recentPosts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                class="flex items-baseline justify-between gap-4 py-4 group"
              >
                <div class="flex items-baseline gap-3 min-w-0">
                  <span class="font-mono text-[10px] text-ghost shrink-0 w-16">
                    {typeLabel[post.data.type ?? "kezako"]}
                  </span>
                  <span class="text-sm text-fg2 truncate group-hover:text-fg transition-colors">
                    {post.data.title}
                  </span>
                </div>
                <span class="font-mono text-[11px] text-ghost shrink-0">
                  {post.data.date}
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="font-mono text-xs text-ghost">
          Aucun article publié pour l'instant.
        </p>
      )
    }
  </section>
</Layout>
