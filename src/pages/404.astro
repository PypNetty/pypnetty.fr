---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — PypNetty" noindex>
  <div class="max-w-3xl mx-auto px-6 pt-32 pb-32">
    <p class="font-mono text-xs text-ghost mb-4 tracking-widest uppercase">404</p>
    <h1 class="text-3xl font-semibold tracking-tight mb-4">Page introuvable</h1>
    <p class="text-subtle mb-10">Cette page n'existe pas ou a été déplacée.</p>
    <a href="/" class="font-mono text-sm border border-edge px-4 py-2 hover:border-fg transition-colors">
      ← retour à l'accueil
    </a>
  </div>
</Layout>
