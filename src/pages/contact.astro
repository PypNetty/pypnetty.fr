---
import Layout from "../layouts/Layout.astro";

const channels = [
  { label: "GitHub",   href: "https://github.com/pypnetty",     handle: "@pypnetty"  },
  { label: "Twitter",  href: "https://twitter.com/PypNetty0",   handle: "@PypNetty0" },
  { label: "LinkedIn", href: "https://linkedin.com/in/pypnetty", handle: "pypnetty"  },
];
---

<Layout title="Contact — PypNetty" description="Me contacter.">
  <div class="max-w-3xl mx-auto px-6 pt-16 pb-32">

    <header class="py-12 border-b border-edge mb-12">
      <p class="font-mono text-xs text-ghost mb-3 tracking-widest uppercase">ping</p>
      <h1 class="text-3xl font-semibold tracking-tight">Contact</h1>
    </header>

    <p class="text-dim mb-12 leading-relaxed max-w-md">
      Une question, une collaboration, ou juste envie d'échanger sur
      Kubernetes et les systèmes distribués ? Je suis disponible sur ces canaux.
    </p>

    <ul class="divide-y divide-edge">
      {channels.map(({ label, href, handle }) => (
        <li>
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between py-4 group hover:opacity-75 transition-opacity"
          >
            <div class="flex items-center gap-6">
              <span class="font-mono text-xs text-ghost w-16">{label}</span>
              <span class="text-sm text-fg2 group-hover:text-fg transition-colors">{handle}</span>
            </div>
            <span class="font-mono text-xs text-ghost">→</span>
          </a>
        </li>
      ))}
    </ul>

  </div>
</Layout>
