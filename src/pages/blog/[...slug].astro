---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const TYPE_LABEL: Record<string, string> = {
  kezako: "kezako",
  "deep-dive": "deep-dive",
};

interface Props {
  entry: CollectionEntry<"blog">;
  satellites?: CollectionEntry<"blog">[];
}

export async function getStaticPaths() {
  const TYPE_ORDER: Record<string, number> = {
    kezako: 0,
    "deep-dive": 1,
  };

  function sortSatellites(
    a: CollectionEntry<"blog">,
    b: CollectionEntry<"blog">,
  ) {
    return (
      (TYPE_ORDER[a.data.type ?? "kezako"] ?? 2) -
      (TYPE_ORDER[b.data.type ?? "kezako"] ?? 2)
    );
  }

  const entries = await getCollection("blog", ({ data }) => {
    if (import.meta.env.DEV) return true;
    return !data.draft && new Date(data.date) <= new Date();
  });

  return await Promise.all(
    entries.map(async (entry) => {
      const satellites = entry.data.subseries
        ? (
            await getCollection("blog", ({ data }) => {
              if (!import.meta.env.DEV && data.draft) return false;
              return (
                data.subseries === entry.data.subseries &&
                (data.type === "kezako" || data.type === "deep-dive")
              );
            })
          ).sort(sortSatellites)
        : [];

      return {
        params: { slug: entry.id },
        props: { entry, satellites },
      };
    }),
  );
}

const { entry, satellites = [] } = Astro.props;
const { Content } = await render(entry);

const sectionTitle =
  satellites.length > 0
    ? satellites.every((post) => post.data.type === "kezako")
      ? "Kezako associés"
      : satellites.every((post) => post.data.type === "deep-dive")
        ? "Deep-Dives associés"
        : "Pour aller plus loin"
    : null;
---

<Layout
  title={`${entry.data.title} — PypNetty`}
  description={entry.data.excerpt}
  image={entry.data.image}
>
  <div class="max-w-3xl mx-auto px-6 pt-16 pb-32">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 font-mono text-xs mb-12">
      <a href="/blog" class="text-accent hover:opacity-70 transition-opacity"
        >blog</a
      >
      {
        entry.data.series && (
          <>
            <span class="text-ghost">/</span>
            <span class="text-ghost">{entry.data.series}</span>
          </>
        )
      }
      <span class="text-ghost">/</span>
      <span class="text-ghost truncate max-w-[200px]">{entry.data.title}</span>
    </div>

    <!-- Header -->
    <header class="border-b border-edge pb-12 mb-12">
      <div
        class="flex items-center gap-3 font-mono text-[11px] text-ghost mb-6"
      >
        <span>{entry.data.date}</span>
        {
          entry.data.category && (
            <>
              <span>·</span>
              <span class="border border-edge px-1.5 py-0.5">
                {entry.data.category}
              </span>
            </>
          )
        }
        {
          entry.data.readTime && (
            <>
              <span>·</span>
              <span>{entry.data.readTime}</span>
            </>
          )
        }
        {
          entry.data.type === "series" && (
            <>
              <span>·</span>
              <span class="text-accent border border-accent/30 px-1.5 py-0.5">
                série
              </span>
            </>
          )
        }
      </div>

      <h1
        class="text-3xl sm:text-4xl font-semibold tracking-tight leading-tight mb-4"
      >
        {entry.data.title}
      </h1>
      <p class="text-dim leading-relaxed">{entry.data.excerpt}</p>

      {
        entry.data.image && (
          <div class="mt-8 border border-edge overflow-hidden">
            <img
              src={entry.data.image}
              alt={`Illustration — ${entry.data.title}`}
              class="w-full object-cover"
              loading="lazy"
              width="800"
              height="400"
            />
          </div>
        )
      }
    </header>

    <!-- Content -->
    <article
      class="prose prose-invert max-w-none prose-p:mb-5 prose-headings:mt-10"
    >
      <Content />
    </article>

    <!-- Articles satellites -->
    {
      satellites.length > 0 && sectionTitle && (
        <section class="mt-20 pt-8 border-t border-edge">
          <p class="font-mono text-[10px] text-ghost tracking-widest uppercase mb-6">
            {sectionTitle}
          </p>
          <ul class="divide-y divide-edge">
            {satellites.map((post) => (
              <li>
                <a
                  href={`/blog/${post.id}`}
                  aria-label={`Lire l'article "${post.data.title}" (${TYPE_LABEL[post.data.type ?? "kezako"]})`}
                  class="flex items-baseline justify-between gap-4 py-4 group"
                >
                  <div class="flex items-baseline gap-3 min-w-0">
                    <span class="font-mono text-[10px] text-ghost shrink-0 w-16">
                      {TYPE_LABEL[post.data.type ?? "kezako"]}
                    </span>
                    <span class="text-sm text-fg2 truncate group-hover:text-fg transition-colors">
                      {post.data.title}
                    </span>
                  </div>
                  <span class="font-mono text-[11px] text-ghost shrink-0">
                    {post.data.date}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- Footer nav -->
    <div class="mt-12 pt-8 border-t border-edge">
      <a
        href="/blog"
        class="font-mono text-xs text-ghost hover:text-fg transition-colors"
      >
        ← tous les articles
      </a>
    </div>
  </div>
</Layout>
