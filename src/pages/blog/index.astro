---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => {
  if (import.meta.env.DEV) return true;
  return !data.draft && new Date(data.date) <= new Date();
});

const posts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const sagas     = posts.filter((p) => p.data.type === "saga").sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const deepDives = posts.filter((p) => p.data.type === "deep-dive");
const kezakos   = posts.filter((p) => p.data.type === "kezako");

type Post = typeof posts[number];
const sections: { label: string; slug: string; desc: string; posts: Post[] }[] = [
  { label: "Saga",      slug: "saga",      desc: "Fiction technique longue durée",     posts: sagas     },
  { label: "Deep-Dive", slug: "deep-dive", desc: "Analyse approfondie d'un concept",   posts: deepDives },
  { label: "Kezako",    slug: "kezako",    desc: "Explications courtes et directes",    posts: kezakos   },
];
---

<Layout
  title="Blog — PypNetty"
  description="Articles sur Kubernetes, Linux, DevOps et les systèmes distribués."
>
  <div class="max-w-3xl mx-auto px-6 pt-16 pb-32">

    <!-- Header -->
    <header class="py-14 border-b border-edge mb-16">
      <p class="font-mono text-[10px] text-ghost mb-4 tracking-widest uppercase">var/logs</p>
      <h1 class="text-4xl font-semibold tracking-tight mb-3">Blog</h1>
      <p class="text-quiet text-base">
        {posts.length} article{posts.length !== 1 ? "s" : ""} · Kubernetes, Linux, DevOps, SRE
      </p>
    </header>

    {sections.map(({ label, slug, desc, posts: sectionPosts }) =>
      sectionPosts.length > 0 && (
        <section class="mb-20" id={slug}>
          <!-- Section header -->
          <div class="flex items-baseline gap-4 mb-6 pb-3 border-b border-edge">
            <p class="font-mono text-xs text-accent tracking-widest uppercase">{label}</p>
            <p class="font-mono text-[11px] text-ghost">{desc}</p>
          </div>

          <!-- Post list -->
          <ul class="space-y-1">
            {sectionPosts.map((post) => (
              <li>
                <a
                  href={`/blog/${post.id}`}
                  class="group flex flex-col gap-1 py-4 px-4 -mx-4 hover:bg-surface transition-colors"
                >
                  <div class="flex items-baseline justify-between gap-4">
                    <p class="text-sm font-medium text-fg2 group-hover:text-fg transition-colors">
                      {post.data.title}
                    </p>
                    <span class="font-mono text-[11px] text-ghost shrink-0">{post.data.date}</span>
                  </div>
                  <p class="font-mono text-[11px] text-ghost leading-relaxed line-clamp-1">
                    {post.data.excerpt}
                  </p>
                  {post.data.category && (
                    <span class="font-mono text-[10px] text-accent/60 mt-0.5">{post.data.category}</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    )}

    {posts.length === 0 && (
      <p class="font-mono text-xs text-ghost py-12">Aucun article publié pour l'instant.</p>
    )}
  </div>
</Layout>
